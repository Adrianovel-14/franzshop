---
import '../styles/global.css';
import { categorias, productos, base, whatsapp, foto, agotado, negocio, sitio, diccionario, textoBusqueda } from '../lib/datos';

// schema: datos para Google (JSON-LD), ver src/lib/seo.ts
interface Props { title: string; description: string; image?: string; noindex?: boolean; schema?: object }
const { title, description, image, noindex = false, schema } = Astro.props;
// "<" escapado igual que abajo, para que ningún texto pueda cerrar la etiqueta <script>
const schemaJson = schema ? JSON.stringify(schema).replace(/</g, '\\u003c') : '';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image ? new URL(image, Astro.site).href : undefined;

// Datos mínimos para el buscador y el pedido en el navegador
const mini = productos.map((p) => ({ id: p.id, n: p.nombre, c: p.cat, p: p.precio, f: foto(p), k: textoBusqueda(p), ...(agotado(p.id) ? { a: 1 } : {}) }));
const cats = categorias.map((c) => ({ id: c.id, n: c.nombre, s: c.corto, t: c.total }));
// "<" escapado para que ningún texto del catálogo pueda cerrar la etiqueta <script> por error
const datosJson = JSON.stringify({ wa: whatsapp, base, sitio, p: mini, c: cats, d: diccionario }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<meta name="theme-color" content="#ffffff">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
{og && <meta property="og:image" content={og}>}
<meta property="og:site_name" content="Franzshopp">
<meta property="og:locale" content="es_PE">
{schemaJson && <script type="application/ld+json" set:html={schemaJson}></script>}
<link rel="icon" href={`${base}/favicon.png`} type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet">
<!-- Umami: no contar mis visitas si abro la tienda con ?no-contar -->
<script is:inline>if (location.search.includes('no-contar')) localStorage.setItem('umami.disabled', '1');</script>
<!-- Umami: estadísticas de visitas (solo cuenta en franzshopp.com, no en localhost) -->
<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="7f2a36d9-17fc-43d2-b410-125d6f5e96a6" data-domains="franzshopp.com"></script>

</head>
<body>
<a class="skip" href="#contenido">Ir al contenido</a>

<header class="header">
  <div class="wrap header__row">
    <a class="logo" href={`${base}/`} aria-label="Franzshopp, inicio">
      <img class="logo__img" src={`${base}/logo-franzshopp.png`} alt="Franzshopp" width="480" height="183" />
    </a>

    <form class="search" role="search" action={`${base}/`} data-search>
      <label for="q" class="visually-hidden">Buscar productos</label>
      <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" name="q" type="search" placeholder="Buscar herramientas…" autocomplete="off" enterkeyhint="search"
        role="combobox" aria-expanded="false" aria-controls="suggest" aria-autocomplete="list">
      <kbd class="search__kbd" aria-hidden="true">/</kbd>
      <ul id="suggest" class="suggest" role="listbox" hidden></ul>
    </form>

    <button type="button" class="cart-btn" data-cart-open aria-label="Ver mi pedido">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h9.3a1 1 0 0 0 1-.8L20 8H6.2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
      <span class="cart-btn__txt">Mi pedido</span>
      <span class="cart-btn__n num" data-cart-count hidden>0</span>
    </button>
  </div>
  <nav class="catbar" aria-label="Categorías">
    <div class="wrap catbar__row">
      <a class="catbar__btn" href={`${base}/#catalogo`} data-cat="todo">Todo</a>
      {categorias.map((c) => <a class="catbar__btn" href={`${base}/categoria/${c.id}/`} data-cat={c.id} aria-current={Astro.url.pathname.includes(`/categoria/${c.id}/`) ? 'page' : undefined}>{c.corto}</a>)}
    </div>
  </nav>
</header>

<main id="contenido">
  <slot />
</main>

<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <a class="logo" href={`${base}/`} aria-label="Franzshopp, inicio">
        <img class="logo__img" src={`${base}/logo-franzshopp.png`} alt="Franzshopp" width="480" height="183" />
      </a>
      <p class="footer__txt">Herramientas Total con garantía y asesoría. Despachamos desde {negocio.ciudad} a todo el Perú.</p>
      <a class="btn btn--line" href={`https://wa.me/${whatsapp}`}>Escribir por WhatsApp</a>
    </div>
    <div>
      <h2 class="footer__h">Categorías</h2>
      <ul class="footer__links">
        {categorias.map((c) => <li><a href={`${base}/categoria/${c.id}/`} data-cat={c.id}>{c.nombre}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer__h">Contacto</h2>
      <ul class="footer__links">
        <li><a href={`https://wa.me/${whatsapp}`}>WhatsApp +51 955 769 076</a></li>
        <li>Atención: {negocio.horario}</li>
        <li>Envíos a todo el Perú desde {negocio.ciudad}</li>
        <li>{negocio.recojo}</li>
      </ul>
    </div>
  </div>
  <div class="wrap footer__base"><p>Franzshopp · Arequipa, Perú · Precios en soles</p><p>Desarrollado por <a href="https://misticode.netlify.app/" target="_blank" rel="noopener">MistiCode</a></p></div>
</footer>

<dialog class="drawer" data-cart aria-labelledby="cart-h">
  <div class="drawer__head">
    <h2 id="cart-h">Mi pedido</h2>
    <button type="button" class="icon-btn" data-close aria-label="Cerrar pedido"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
  <div class="drawer__body">
    <p class="drawer__empty" data-cart-empty>Aún no agregas productos.</p>
    <ul class="lines" data-cart-lines></ul>
  </div>
  <div class="drawer__foot">
    <p class="drawer__total">Total <strong class="num" data-cart-total>S/ 0</strong></p>
    <a class="btn btn--accent btn--full" data-wa href={`https://wa.me/${whatsapp}`}>Enviar pedido por WhatsApp</a>
    <p class="drawer__note">Te confirmamos stock y envío (o recojo en almacén) por el chat.</p>
  </div>
</dialog>

<div class="toast" data-toast role="status" aria-live="polite"></div>

<script type="application/json" id="fs-datos" set:html={datosJson}></script>
<script>
  import { iniciarTienda } from '../scripts/tienda';
  iniciarTienda();
</script>
</body>
</html>
