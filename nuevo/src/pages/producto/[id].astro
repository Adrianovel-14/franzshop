---
import Base from '../../layouts/Base.astro';
import { productos, catPorId, foto, soles, waLink, base, agotado, avisameTexto, negocio, type Producto } from '../../lib/datos';
import { tituloProducto, descripcionProducto, schemaProducto, apodosDe } from '../../lib/seo';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props as { p: Producto };
const cat = catPorId[p.cat];
const specs = [
  ['Potencia', p.potencia],
  ['Incluye', p.incluye],
  ['Sirve para', p.uso ? p.uso.charAt(0).toUpperCase() + p.uso.slice(1) : undefined],
  ['Marca', p.marca],
  // nombres populares (chicharra, esmeril…): ayudan a que Google la encuentre con esas palabras
  ['También le dicen', apodosDe(p).join(', ') || undefined],
  ['Envío', `A todo el Perú desde ${negocio.ciudad}, se coordina por WhatsApp`],
  ['Recojo', negocio.recojo],
].filter(([, v]) => v) as [string, string][];
const sinStock = agotado(p.id);
const parecidos = productos.filter((x) => x.cat === p.cat && x.id !== p.id && x.foto && !agotado(x.id))
  .sort((a, b) => Math.abs(a.precio - p.precio) - Math.abs(b.precio - p.precio)).slice(0, 4);
---
<Base title={tituloProducto(p)} description={descripcionProducto(p)} image={p.foto ? foto(p) : undefined} schema={schemaProducto(p)}>
  <nav class="wrap crumbs" aria-label="Ruta">
    <a href={`${base}/`}>Inicio</a><span aria-hidden="true">/</span>
    <a href={`${base}/categoria/${p.cat}/`}>{cat?.nombre}</a>
  </nav>

  <section class="wrap pd">
    <div class:list={['pd__pic', { 'pd__pic--agotado': sinStock }]} data-tilt="6">
      <div class="pd__img">
        {p.foto ? <img src={foto(p)} alt={p.nombre} width="900" height="900" fetchpriority="high" /> : <span class="nopic">{p.nombre}</span>}
      </div>
    </div>
    <div class="pd__info">
      <p class="eyebrow">{cat?.nombre} · {p.marca}</p>
      <h1 class="pd__name">{p.nombre}</h1>
      <p class="pd__price num">{soles(p.precio)}</p>
      {sinStock ? (
        <>
          <p class="pd__agotado"><strong>Sin stock por ahora.</strong> Escríbenos y te avisamos apenas llegue.</p>
          <div class="pd__buy">
            <a class="btn btn--accent" href={waLink(avisameTexto(p))} target="_blank" rel="noopener">Avísame por WhatsApp cuando haya stock</a>
          </div>
        </>
      ) : (
        <>
          <div class="pd__buy">
            <div class="qty" role="group" aria-label="Cantidad">
              <button type="button" data-step="-1" data-target="#pd-qty" aria-label="Quitar uno">−</button>
              <output id="pd-qty" class="num">1</output>
              <button type="button" data-step="1" data-target="#pd-qty" aria-label="Agregar uno">+</button>
            </div>
            <button type="button" class="btn btn--accent" data-add={p.id} data-qty-from="#pd-qty">Agregar al pedido</button>
          </div>
          <a class="pd__wa" href={waLink(`Hola Franzshopp, quiero información de: ${p.nombre} (${soles(p.precio)})`)}>Preguntar por este producto en WhatsApp</a>
        </>
      )}
      <dl class="specs">
        {specs.map(([k, v]) => {
          // "- Sierra - Taladro - ..." se muestra como lista, un artículo por línea
          const items = k === 'Incluye' ? v.split(/(?:^|\s+)-\s+/).map((x) => x.trim()).filter(Boolean) : [];
          return <div><dt>{k}</dt><dd>{items.length > 1 ? <ul class="specs__list">{items.map((x) => <li>{x}</li>)}</ul> : v}</dd></div>;
        })}
      </dl>
    </div>
  </section>

  {parecidos.length > 0 && (
    <section class="wrap sec" aria-labelledby="sim-h">
      <div class="sec-head"><h2 id="sim-h">Más en {cat?.nombre}</h2><a class="sec-head__link" href={`${base}/categoria/${p.cat}/`}>Ver todo</a></div>
      <ul class="grid grid--4">
        {parecidos.map((x) => (
          <li class="card">
            <a class="card__open" href={`${base}/producto/${x.id}/`}>
              <span class="card__media"><span class="card__pic"><img src={foto(x)} alt={x.nombre} width="600" height="600" loading="lazy" decoding="async" /></span></span>
              <span class="card__body"><span class="card__cat">{cat?.corto}</span><span class="card__name">{x.nombre}</span></span>
            </a>
            <div class="card__foot">
              <span class="card__price num">{soles(x.precio)}</span>
              <button type="button" class="add" data-add={x.id} aria-label={`Agregar ${x.nombre} al pedido`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>Agregar</span></button>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
